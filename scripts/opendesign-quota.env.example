# OpenDesign quota collector environment template.
# Copy outside the repository to /vol1/1000/docker/newapi/usage/collector/quota-collector.env (mode 600).
# Before installing the service, configure a dedicated unprivileged User and systemd sandbox.
# Restrict the existing snapshot directory and mount only usage/snapshot into the container.
# Deploy both opendesign-direct-quota.mjs and antigravity-statusline.mjs.
# The control key is an account-level credential that can read the wallet: keep it
# in this file only. Never put it in the repository, a snapshot, or a log line.

# Control-plane key (vela_ctrl_…). The inference key (sk-amr-…) cannot read quota.
OPENDESIGN_CONTROL_KEY=

# Workspace ID from GET /api/v1/workspaces on the control plane.
OPENDESIGN_WORKSPACE_ID=

# Sanitized snapshot the collector writes; the container reads it read-only.
OPENDESIGN_USAGE_FILE=/vol1/1000/docker/newapi/usage/snapshot/opendesign-usage.json

# Optional User-Agent override; defaults to new-api-usage-collector/1.0.
OPENDESIGN_QUOTA_USER_AGENT=
